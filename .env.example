PRESENCE_HOST=127.0.0.1
PRESENCE_GATEWAY_PORT=8797
PRESENCE_GAME_PORT=8798
PRESENCE_MACHINE_ID=local-1
PRESENCE_ADMIN_TOKEN=
PRESENCE_PUBLIC_SOCKET_URL=wss://us1.gameserver.keepwork.com/world/{port}
# Any page origin may use the Bearer-authenticated join endpoint (not admin APIs).
PRESENCE_ALLOWED_ORIGINS=*

# 用户分析默认开启；设为 0 禁用。目录需要持久化磁盘，不放在网站公开目录。
PRESENCE_ANALYTICS=1
PRESENCE_ANALYTICS_DIR=var/analytics
