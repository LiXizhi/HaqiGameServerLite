{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "haqi server: start",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "haqi-server",
        "pattern": {
          "regexp": "^(?!x)x"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^",
          "endsPattern": "presence ready"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "haqi server: test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
